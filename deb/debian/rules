#!/usr/bin/make -f

# Set the default target to build the package
%:
	dh $@

# Build the binary and stage the shared texts, then install everything via dh_install
override_dh_auto_install:
	mkdir -p ./usr/games/lodge
	cp -R ../texts ./usr/games/lodge/texts
	gcc -Wall -DLODGE_VERSION=\"$$(cat ../VERSION)\" -I../include -o ./usr/games/lodge/lodge ../src/lodge.c -lpthread
	dh_install
	# Ensure maintainer scripts have the correct permissions
	chmod 755 debian/postrm debian/postinst

# Override clean to clean up build files
override_dh_clean:
	dh_clean
	rm -rf build
