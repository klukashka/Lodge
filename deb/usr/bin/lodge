#!/bin/bash
bin=/usr/games/lodge/lodge
texts=/usr/games/lodge/texts

# Opt-in: LODGE_NEW_WINDOW=1 opens a separate full-screen gnome-terminal instead.
if [[ "${LODGE_NEW_WINDOW:-0}" == "1" ]] && command -v gnome-terminal >/dev/null 2>&1; then
    exec gnome-terminal --full-screen -- env LODGE_WAIT_RESIZE=1 "$bin" "$texts/lodge_pic.txt" "$texts/message.txt"
fi

# Default (like `sl`): run right here, taking over the current terminal until Ctrl+C.
exec "$bin" "$texts/lodge_pic.txt" "$texts/message.txt"
